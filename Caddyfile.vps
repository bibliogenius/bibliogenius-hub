# Caddy reverse proxy for Scaleway VPS
# Installed on the host at /etc/caddy/Caddyfile
# Handles TLS termination via Let's Encrypt
# Proxies to FrankenPHP containers on localhost

# Production
hub.bibliogenius.org {
    # WebSocket endpoint (ADR-017) - skip access log to avoid leaking
    # tokens if passed as query param fallback.
    handle /ws {
        skip_log
        reverse_proxy localhost:9091
    }
    handle {
        reverse_proxy localhost:8080
    }
}

hub-dev.bibliogenius.org {
    handle /ws {
        skip_log
        reverse_proxy localhost:9092
    }
    handle {
        reverse_proxy localhost:8081
    }
}

# Vitrine + blog statique (migré depuis GitHub Pages le 2026-05-07)
# Contenu déployé via `make deploy` depuis bibliogenius-public/
www.bibliogenius.org {
    redir https://bibliogenius.org{uri} permanent
}

bibliogenius.org {
    root * /var/www/bibliogenius.org
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    @aasa path /.well-known/apple-app-site-association
    header @aasa Content-Type application/json

    @assetlinks path /.well-known/assetlinks.json
    header @assetlinks Content-Type application/json

    file_server
}
