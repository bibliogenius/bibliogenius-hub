# Caddy reverse proxy for Scaleway VPS
# Installed on the host at /etc/caddy/Caddyfile
# Handles TLS termination via Let's Encrypt
# Proxies to FrankenPHP containers on localhost

# Production
hub.bibliogenius.org {
    # WebSocket endpoint (ADR-017) - no access log to avoid leaking
    # tokens if passed as query param fallback.
    handle /ws {
        log {
            output discard
        }
        reverse_proxy localhost:9091
    }
    handle {
        reverse_proxy localhost:8080
    }
}

hub-dev.bibliogenius.org {
    handle /ws {
        log {
            output discard
        }
        reverse_proxy localhost:9092
    }
    handle {
        reverse_proxy localhost:8081
    }
}
