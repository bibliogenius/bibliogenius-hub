{
    auto_https off
    admin off
}

:80 {
    root * /app/public
    encode zstd gzip

    # ADR-035 §2bis: static city data, raw gzipped JSON. Must come before
    # the @static block so the .gz extension does not fall through to PHP.
    @cities path /static/cities/*
    handle @cities {
        log_skip
        header Cache-Control "public, max-age=2592000, immutable"
        header Access-Control-Allow-Origin "*"
        file_server
    }

    # Serve static files directly
    @static {
        file
        path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
    }
    handle @static {
        file_server
    }

    # Handle all other requests through Symfony
    reverse_proxy localhost:9000 {
        transport fastcgi {
            root /app/public
            split .php
        }
    }
}
