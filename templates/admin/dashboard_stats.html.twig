            </td>
            <td>
                <div class="db-bar-wrap">
                    <div class="db-bar" style="width:{{ pct }}%"></div>
                </div>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

{# ────────────────────────────────────────────────
   Hub Events
   ──────────────────────────────────────────────── #}
<div class="section-title" id="hub-events" style="margin-top: 32px;">Recent Hub Events</div>
<p class="section-legend">
    Last 50 events. <strong>error</strong> = requires investigation (database or server fault).
    <strong>warning</strong> = client-side issue, usually no server action needed (stale tokens, invalid requests).
    <strong>info</strong> = normal operation.
    Hover a message for a plain-language explanation.
</p>
{% if recent_events is empty %}
    <p class="muted" style="padding: 12px 0;">No events recorded yet.</p>
{% else %}
<table class="hub-table">
    <thead>
        <tr>
            <th>When</th>
            <th>Level</th>
            <th>Channel</th>
            <th>Message</th>
            <th>Context</th>
        </tr>
    </thead>
    <tbody>
        {% for evt in recent_events %}
        <tr>
            <td style="white-space: nowrap;">
                <div><time datetime="{{ evt.created_at|date('c', 'UTC') }}" data-utc data-format="date">{{ evt.created_at|date('d/m/Y', 'UTC') }}</time></div>
                <div class="evt-date"><time datetime="{{ evt.created_at|date('c', 'UTC') }}" data-utc data-format="time">{{ evt.created_at|date('H:i:s', 'UTC') }}</time></div>
            </td>
            <td>
                {% if evt.level == 'error' %}
                    <span class="badge badge-error">error</span>
                {% elseif evt.level == 'warning' %}
                    <span class="badge badge-warning">warning</span>
                {% else %}
                    <span class="badge badge-info">{{ evt.level }}</span>
                {% endif %}
            </td>
            <td>
                {% if evt.channel == 'relay' %}
                    <span class="badge badge-relay"
                          title="Relay messaging: deposit/collection of encrypted messages between peers.">relay</span>
                {% elseif evt.channel == 'directory' %}
                    <span class="badge badge-directory"
                          title="Directory: profile registration, updates, or lookups.">directory</span>
                {% else %}
                    <span class="badge badge-muted">{{ evt.channel }}</span>
                {% endif %}
            </td>
            <td>
                {# Plain-language explanations for known messages #}
                {% set msg_tips = {
                    'deposit to non-existent mailbox':
                        'A peer is sending to a deleted mailbox. Fix: the sender needs a fresh invitation. No server action needed.',
                    'invalid write token':
                        'Peer is using an expired or revoked invitation link. Fix: regenerate an invitation.',
                    'collect from non-existent mailbox':
                        'Collection from a non-existent mailbox. The peer needs to re-register with the hub.',
                    'mailbox creation failed':
                        'Mailbox creation failed — database issue. Check the Context column for the error detail.',
                    'deposit failed':
                        'Message deposit failed — database issue. Check the Context column.',
                    'registration rejected (missing write_token)':
                        'Missing write token. Outdated client (pre-v0.8) or unauthorized attempt. Suspicious if recurring.',
                    'upsert forbidden':
                        'Profile update rejected: peer tried to modify a profile it does not own.',
                    'upsert failed':
                        'Profile update failed — database issue. Check Context for detail.',
                    'recovery failed (invalid code)':
                        'Invalid recovery code entered. Suspicious if repeated from different sources.',
                    'profile recovered via recovery code':
                        'Profile successfully recovered via recovery code. Informational, no action needed.',
                    'profile lookup: not found':
                        'Profile lookup returned no result. Normal if the node_id is unknown to this hub.',
                } %}
                {% if msg_tips[evt.message] is defined %}
                    <span title="{{ msg_tips[evt.message] }}" style="cursor: help; border-bottom: 1px dotted #adb5bd;">{{ evt.message }}</span>
                {% else %}
                    {{ evt.message }}
                {% endif %}
            </td>
            <td class="context-cell" {% if evt.context %}title="{{ evt.context }}"{% endif %}>
                {{ evt.context }}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}
{% endblock %}
