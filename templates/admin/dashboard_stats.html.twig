        </div>
    </div>

    <div class="stat-card">
        <div class="stat-label">
            Resolutions (24h)
            <i class="tip" data-tip="Cache writes in the last 24h, every outcome (resolved, ambiguous, unknown). Same population the non-resolved share to the right is computed over.">i</i>
        </div>
        <div class="stat-value">{{ discovery_resolutions_24h }}</div>
        <div class="stat-sub">cache writes, all outcomes</div>
    </div>

    <div class="stat-card {{ discovery_non_resolved_share_24h is not null and discovery_non_resolved_share_24h >= discovery_drift_alert_threshold ? 'status-alert' : (discovery_non_resolved_share_24h is not null ? 'status-ok' : '') }}">
        <div class="stat-label">
            Non-resolved Share (24h)
            <i class="tip" data-tip="Share of the 24h resolutions that ended ambiguous or unknown. At or above {{ discovery_drift_alert_threshold }}%, app:db:prune fires a source-drift warning (Hub Events, channel maintenance, message discovery_drift_degraded), deduplicated to once per 24h. Needs at least {{ discovery_drift_min_samples }} samples in the window, else it reads n/a as statistically meaningless.">i</i>
        </div>
        <div class="stat-value">
            {% if discovery_non_resolved_share_24h is null %}
                n/a
            {% else %}
                {{ discovery_non_resolved_share_24h }}%
            {% endif %}
        </div>
        <div class="stat-sub">
            {% if discovery_non_resolved_share_24h is null %}
                not enough samples yet
            {% elseif discovery_non_resolved_share_24h >= discovery_drift_alert_threshold %}
