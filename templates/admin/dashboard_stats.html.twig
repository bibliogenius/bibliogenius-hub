        <div class="stat-sub">last 30 days</div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 8px;">
    <div>
        <div style="font-size: 12px; font-weight: 600; color: var(--text-muted,#6c757d); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.4px;">
            Loans per day — last 30 days
        </div>
        <canvas id="chart-loans" height="140"></canvas>
    </div>
    <div>
        <div style="font-size: 12px; font-weight: 600; color: var(--text-muted,#6c757d); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.4px;">
            New libraries per week — last 8 weeks
        </div>
        <canvas id="chart-growth" height="140"></canvas>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    const gridColor = 'rgba(0,0,0,0.06)';
    const defaults = {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
            x: { grid: { display: false }, ticks: { font: { size: 11 } } },
            y: { grid: { color: gridColor }, ticks: { font: { size: 11 }, precision: 0 }, beginAtZero: true },
        },
    };

    // Fill missing days with 0 for loans chart
    const loanRaw = {{ loans_per_day|json_encode|raw }};
    const loanMap = Object.fromEntries(loanRaw.map(r => [r.day, parseInt(r.count)]));
    const loanLabels = [], loanData = [];
    for (let i = 29; i >= 0; i--) {
        const d = new Date(); d.setDate(d.getDate() - i);
        const key = d.toISOString().slice(0, 10);
        loanLabels.push(i === 0 ? 'Today' : key.slice(5)); // MM-DD
        loanData.push(loanMap[key] ?? 0);
    }

    new Chart(document.getElementById('chart-loans'), {
        type: 'bar',
        data: {
            labels: loanLabels,
            datasets: [{ data: loanData, backgroundColor: '#0d6efd', borderRadius: 3 }],
        },
        options: {
            ...defaults,
            scales: {
                ...defaults.scales,
                x: { ...defaults.scales.x, ticks: { font: { size: 10 }, maxTicksLimit: 10 } },
            },
        },
    });

    // Library growth chart
    const growthRaw = {{ library_growth|json_encode|raw }};
    new Chart(document.getElementById('chart-growth'), {
        type: 'bar',
        data: {
            labels: growthRaw.map(r => r.week.slice(5, 10)), // MM-DD
            datasets: [{ data: growthRaw.map(r => parseInt(r.count)), backgroundColor: '#198754', borderRadius: 3 }],
        },
        options: defaults,
    });
})();
</script>

