                {{ accepted_loans }} accepted
                ({{ ((accepted_loans / total_loans) * 100)|round }}%)
            {% else %}
                no loans yet
            {% endif %}
        </div>
    </div>

    <div class="stat-card {{ recent_loans > 0 ? 'status-ok' : '' }}">
        <div class="stat-label">
            Loans (30d)
            <i class="tip" data-tip="Borrow requests created in the last 30 days.">i</i>
        </div>
