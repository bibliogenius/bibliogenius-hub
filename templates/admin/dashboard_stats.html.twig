{# ────────────────────────────────────────────────
   C — Mailboxes with pending messages
   ──────────────────────────────────────────────── #}
{% if busy_mailboxes is not empty %}
<div class="section-title" style="margin-top: 32px;">Mailboxes with Pending Messages</div>
<p class="section-legend">
    Encrypted messages waiting to be collected. Having pending messages is <strong>normal</strong> — the recipient peer hasn't polled yet.
    Watch for: <strong>Inactive</strong> (no collection in 7+ days) → the peer is likely gone, delete the mailbox to free space.
    <strong>Late</strong> (48h–7d) → peer is offline, no action needed unless it persists.
    Profile IDs are anonymized node identifiers — no personal data is shown.
</p>
<table class="hub-table">
    <thead>
        <tr>
            <th>Mailbox</th>
            <th>
                Profile
                <i class="tip" data-tip="Anonymized node ID of the library profile that owns this mailbox. Click to open the mailbox detail in EasyAdmin.">i</i>
            </th>
            <th>Pending</th>
            <th>Oldest Message</th>
            <th>Status &amp; Suggested Action</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {% for mb in busy_mailboxes %}
        {% set age_hours = (("now"|date("U")) - (mb.oldest_msg|date("U"))) / 3600 %}
        <tr>
            <td>
                <code class="mono">{{ mb.mailbox_uuid[:8] }}…</code>
            </td>
            <td>
                {% if mb.profile_node_id %}
                    <span class="mono muted" title="Anonymized node ID — no personal data">{{ mb.profile_node_id[:12] }}…</span>
                {% else %}
                    <span class="muted">—</span>
                {% endif %}
            </td>
            <td><strong>{{ mb.msg_count }}</strong></td>
            <td>
                <div><time datetime="{{ mb.oldest_msg|date('c', 'UTC') }}" data-utc data-format="date">{{ mb.oldest_msg|date('d/m/Y', 'UTC') }}</time></div>
                <div class="evt-date"><time datetime="{{ mb.oldest_msg|date('c', 'UTC') }}" data-utc data-format="time">{{ mb.oldest_msg|date('H:i', 'UTC') }}</time></div>
            </td>
            <td>
                {% if age_hours > 168 %}
                    <div class="action-box">
                        <div class="action-label"><span class="badge badge-error">Inactive</span></div>
                        <div class="action-desc">No collection in 7+ days. The peer is likely gone.<br>
                        <strong>Recommended:</strong> delete this mailbox.</div>
                    </div>
                {% elseif age_hours > 48 %}
                    <div class="action-box">
                        <div class="action-label"><span class="badge badge-warning">Late</span></div>
                        <div class="action-desc">No collection in 48h+. Peer is offline.<br>
                        <strong>Wait:</strong> if still Late in 5 more days, consider deleting.</div>
                    </div>
                {% else %}
                    <div class="action-box">
                        <div class="action-label"><span class="badge badge-ok">Normal</span></div>
                        <div class="action-desc">Messages pending &lt;48h. No action needed.</div>
                    </div>
                {% endif %}
            </td>
            <td>
                {% if age_hours > 168 %}
                    <form method="post" action="{{ path('admin_mailbox_delete', {uuid: mb.mailbox_uuid}) }}"
                          onsubmit="return confirm('Delete mailbox {{ mb.mailbox_uuid[:8] }}… and its {{ mb.msg_count }} pending message(s)?\n\nThis is irreversible.')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-mailbox-' ~ mb.mailbox_uuid) }}">
                        <button type="submit" class="btn-delete-sm">Delete</button>
                    </form>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

