# Secrets and local config -- NEVER bake into Docker image
.env.local
.env.*.config
.env.prod
.env.staging

# Git
.git
.gitignore

# CI/CD
.github

# Development
docker-compose*.yml
Makefile
Caddyfile.vps
Caddyfile.container.vps
scripts/
*.md

# Built fresh inside the image: vendor via `composer install` from the
# committed composer.lock, var/ via mkdir in the Dockerfile. Never copy the
# host's (macOS-built) vendor/ or local var/ into a linux/amd64 prod image.
/vendor/
/var/

# ADR-035: city files are runtime data on the host bind mount, never
# baked into the image. A local dev who built them via app:build-cities
# would otherwise leak stale snapshots into every prod image.
public/static/cities/*.json.gz

# IDE
.idea
.vscode

# Rust build artifacts (ws-sidecar compiled locally — can be hundreds of MB)
ws-sidecar/target/

# OS
.DS_Store
